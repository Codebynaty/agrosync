# Porta e host da API (que também serve o app em produção)
PORT=3333
HOST=0.0.0.0

# Obrigatório em produção (NODE_ENV=production)
JWT_SECRET=troque-por-um-segredo-longo

# Segredo HMAC usado para assinar e validar os webhooks Pix
PIX_WEBHOOK_SECRET=troque-este-segredo

# Caminho do banco SQLite
# DATABASE_PATH=./data/agrosync.db

# Demo: devolve o código de login na resposta (não há SMS real). Use false com um provedor de SMS real.
OTP_DEV_ECHO=true

# Gera dados de demonstração quando o banco está vazio
SEED=true

# Clima: "simulado" (padrão) ou "open-meteo" (previsão real, gratuita, sem chave)
CLIMA_PROVIDER=simulado

# Agrupamento automático a cada pedido e nos jobs periódicos
AUTO_AGRUPAR=true
JOBS_INTERVAL_MS=60000

# Parâmetros do frete
FRETE_CAPACIDADE_KG=6000
FRETE_RAIO_KM=25
